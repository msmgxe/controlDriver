# ===========================================================================
# RutaLog — variables de entorno
#
# Copia este archivo a .env.local y rellena los valores. .env.local está en
# .gitignore y no debe subirse nunca al repositorio.
#
# Solo las dos primeras llevan prefijo NEXT_PUBLIC_, es decir, solo esas dos
# llegan al navegador. Las demás se quedan en el servidor (§7).
# ===========================================================================

# --- Supabase: panel del proyecto → Project Settings → API -----------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor. Salta la RLS por completo: se usa únicamente en los Server
# Actions de alta y gestión de cuentas, protegidos por rol (§12).
# Si esta clave se filtra, cualquiera puede leer los datos de todos los drivers.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic: extracción por visión (§4) ---------------------------------
# Solo servidor. La llamada al modelo ocurre en Route Handlers; el cliente
# nunca ve esta clave.
ANTHROPIC_API_KEY=

# Nombre del modelo en variable, para poder cambiarlo sin tocar el código.
ANTHROPIC_MODELO=claude-sonnet-5

# --- Límites de gasto (§7) -------------------------------------------------
LIMITE_CARGAS_POR_HORA=10
LIMITE_IMAGENES_POR_DIA=40

# --- Retención de imágenes (§7, §17.1) -------------------------------------
# Por defecto las capturas se procesan en memoria y se descartan.
# Ponlo en 30 para conservarlas 30 días en un bucket privado de Storage.
DIAS_RETENCION_IMAGENES=0
